{
  "name": "coding-interview-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=@app/server\" \"npm run dev --workspace=@app/client\"",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:e2e": "npx playwright test"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "concurrently": "^9.0.0"
  }
}
